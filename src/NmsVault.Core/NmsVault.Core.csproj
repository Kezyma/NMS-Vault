<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NmsVault.Json\NmsVault.Json.csproj" />
  </ItemGroup>

  <!--
    Internals are visible to the test project so behaviour that is deliberately not public
    API - shape-based kind inference, filename sanitising - can still be tested directly
    rather than only through the public surface.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="NmsVault.Core.Tests" />
  </ItemGroup>

</Project>
