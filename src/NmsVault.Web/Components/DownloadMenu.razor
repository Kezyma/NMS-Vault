@inject ExportService Exports
@inject IJSRuntime Js
@implements IAsyncDisposable

@*
    The download button and the list of formats behind it.

    Four editors, and the file is built here in the browser rather than pre-rendered at ingest,
    so what each one can hold is known only once the item document has been fetched. The menu is
    therefore empty until it is opened, and says so while it fills.

    The panel is the formats and nothing else. What a format cannot hold is worth stopping someone
    for, and that is what the confirmation is; standing caveats about the editors are not, and a
    paragraph of them under every list is noise in front of the thing being chosen.

    It wears .vault-combo so the one document-level listener that closes an open list on a press
    outside it finds this too.
*@

@*
    stopPropagation on the keydown: this menu opens inside the item modal, whose sheet closes
    on Escape. Without it one press closed the menu and the dialog behind it, and left focus on
    the body. ConfirmDialog already carries the same guard for the same reason.
*@
<div class="vault-combo vault-download @(_open ? "open" : null)"
     @onkeydown="OnKey" @onkeydown:stopPropagation="true">
    <button type="button" class="download toggle @(Compact ? "icon" : null)"
            aria-expanded="@(_open ? "true" : "false")" aria-haspopup="menu"
            title="Download this in a save editor's format"
            aria-label="Download this in a save editor's format" @ref="_control"
            @onclick="Flip" @onclick:stopPropagation="true">
        <Icon Name="download" Size="20" Class="accent" />
        @*
            The label and the arrow are the same thing said twice over: both are there to say
            this opens a list, and neither is worth the width beside a title. The icon alone
            is the control.
        *@
        @if (!Compact)
        {
            <span class="label">Download</span>
            <Icon Name="chevron-down" Size="13" Weight="2.4" Class="drop" />
        }
    </button>

    @if (_open)
    {
        @* Placed by script, in viewport coordinates - see anchorPanel in vault.js. *@
        <div class="panel" role="menu" @ref="_panel">
            @*
                The failure is tested first. The other way round the null check won, so a
                failed fetch left _options null and the panel said "Reading the item..."
                for ever.
            *@
            @if (_failed is { Length: > 0 })
            {
                <p class="failed">@_failed</p>
            }
            else if (_options is null)
            {
                <p class="loading dim">Reading the item&hellip;</p>
            }
            else
            {
                <ul class="options">
                    @foreach (var option in _options)
                    {
                        <li @key="option.Editor">
                            @*
                                A format that cannot take this kind at all is shown and disabled
                                rather than left out. An entry that is missing raises the question
                                of whether the gallery forgot it; one that is greyed out with a
                                reason answers it.
                            *@
                            <button type="button" role="menuitem"
                                    class="@(option.NeedsConfirming ? "lossy" : null)"
                                    disabled="@(!option.IsAvailable)"
                                    title="@Tooltip(option)"
                                    @onmousedown:preventDefault="true"
                                    @onclick="() => Choose(option)">
                                <span class="name">@option.Label</span>

                                @if (option.NeedsConfirming)
                                {
                                    <Icon Name="warning" Size="15" Class="warn" />
                                }

                                <span class="ext dim">@(option.Extension ?? "-")</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@if (_asking is { } asking)
{
    <ConfirmDialog Title="@($"{asking.Label} cannot hold everything")"
                   Message="@($"Some of what {Row.DisplayName} carries has nowhere to go in this format.")"
                   OnDismiss="Cancel">
        <Body>
            <ul class="losses">
                @foreach (string loss in asking.Losses)
                {
                    <li>@loss</li>
                }
            </ul>
        </Body>

        <ChildContent>
            <button type="button" class="ghost" @onclick="Cancel">Cancel</button>
            <button type="button" class="danger" @onclick="() => Save(asking)">
                Download anyway
            </button>
        </ChildContent>
    </ConfirmDialog>
}

@code {
    /// <summary>The item to offer.</summary>
    [Parameter, EditorRequired]
    public required GalleryRow Row { get; set; }

    /// <summary>
    /// Whether to draw the control as an icon rather than a labelled button.
    /// </summary>
    /// <remarks>
    /// For the places where it sits beside a title or in a table row, where the word would be
    /// the widest thing in a column that has no room for it. The accessible name stays the
    /// same either way, so what a screen reader hears does not depend on where it is drawn.
    /// </remarks>
    [Parameter]
    public bool Compact { get; set; }

    private bool _open;
    private ElementReference _control;
    private ElementReference _panel;
    private IReadOnlyList<DownloadOption>? _options;
    private DownloadOption? _asking;
    private string? _failed;
    private IJSObjectReference? _module;

    private static string Tooltip(DownloadOption option) => option switch
    {
        { Unsupported: { } why } => why,
        { Losses.Count: > 0 } => $"Loses {option.Losses.Count} thing{(option.Losses.Count == 1 ? "" : "s")} - you will be asked first",
        _ => $"Download for {option.Label}",
    };

    private async Task Flip()
    {
        _open = !_open;
        if (!_open) { return; }

        // Cleared on open, so a failure that has since been fixed - a publish that had not
        // finished, a connection that has come back - does not keep showing its message for
        // the rest of the session.
        _failed = null;

        // Fetched on opening rather than with the card: a page of twenty ships would otherwise
        // pull twenty whole ship documents to draw twenty buttons nobody has pressed.
        if (_options is not null) { return; }

        try
        {
            _options = await Exports.OptionsAsync(Row.Id).ConfigureAwait(true);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _failed = "That item could not be read. It may not have finished publishing.";
        }
    }

    private async Task Choose(DownloadOption option)
    {
        if (!option.IsAvailable) { return; }

        if (option.NeedsConfirming)
        {
            _asking = option;
            _open = false;
            return;
        }

        await Save(option).ConfigureAwait(true);
    }

    private async Task Save(DownloadOption option)
    {
        _asking = null;
        _open = false;

        try
        {
            var file = await Exports.ExportAsync(Row.Id, option.Editor).ConfigureAwait(true);

            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./vault.js").ConfigureAwait(true);
            await _module.InvokeVoidAsync(
                "saveFile", file.FileName, Convert.ToBase64String(file.Content), "application/json")
                .ConfigureAwait(true);
        }
        catch (Exception e) when (e is HttpRequestException or NotSupportedException)
        {
            _failed = $"That file could not be built: {e.Message}";
            _open = true;
        }
    }

    private void Cancel() => _asking = null;

    /// <summary>
    /// Registers the two listeners that close this menu, and places the panel once it exists.
    /// </summary>
    /// <remarks>
    /// The outside-press listener is the same one the filter bar's lists use; it is registered
    /// here as well rather than relying on a filter bar being on the page, since the listener
    /// guards against being added twice and a card is not entitled to assume what was rendered
    /// beside it.
    /// <para>
    /// Placing happens after the render that drew the panel, because the panel has to be in the
    /// document before its height can be measured and it can decide whether to open downwards.
    /// It is placed again after the options arrive, since that is when it reaches full height.
    /// </para>
    /// </remarks>
    /// <param name="firstRender">Whether this is the first render.</param>
    /// <returns>A task that completes once the listeners are in place and the panel is placed.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var module = _module ??= await Js
            .InvokeAsync<IJSObjectReference>("import", "./vault.js").ConfigureAwait(true);

        if (firstRender)
        {
            await module.InvokeVoidAsync("closeListsOnOutsidePress").ConfigureAwait(true);
            await module.InvokeVoidAsync("closeMenusOnScroll").ConfigureAwait(true);
        }

        if (_open)
        {
            await module.InvokeVoidAsync("anchorPanel", _panel, _control).ConfigureAwait(true);
        }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _open = false; }
    }

    /// <summary>Releases the imported module.</summary>
    /// <returns>A task that completes when it is released.</returns>
    public async ValueTask DisposeAsync()
    {
        if (_module is null) { return; }

        try
        {
            await _module.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there is nothing left to release.
        }
    }
}
