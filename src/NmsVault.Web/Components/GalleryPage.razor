@inject GalleryData Data
@inject TechData Tech

@*
    One room of the gallery: a filter bar, then the items as cards or as a table.

    The page owns one sifter and hands the same instance to the search box and to every
    heading. They all write into it and all call back here, which recomputes the narrowed
    list once rather than each of them keeping its own idea of what is shown.
*@

<h1>@Heading</h1>

@if (_all is null)
{
    <p class="dim">Loading&hellip;</p>
}
else
{
    <div class="filter-bar">
        <SearchBox TRow="GalleryRow" Filter="_filter" OnChanged="FilterChanged"
                   Id="@($"{Page.ToLowerInvariant()}-search")"
                   Label="@($"Search {Heading}")"
                   Placeholder="@($"Search {Heading.ToLowerInvariant()}…")" />

        @foreach (var facet in _facets)
        {
            <MultiSelect TRow="GalleryRow" Facet="facet" Rows="_all"
                         Ticked="_filter.Ticked(facet.Key)" OnChanged="FilterChanged" @key="facet.Key" />
        }

        @*
            Only over the cards. The table sorts by its own headings, and a dropdown above it
            would be a second way to say the same thing with one place for the two to disagree.
        *@
        @if (!_asTable)
        {
            <div class="sort-by">
                <label for="@($"{Page.ToLowerInvariant()}-sort")">Sort by</label>
                <select id="@($"{Page.ToLowerInvariant()}-sort")" @onchange="SortChanged">
                    @foreach (var sort in _sorts)
                    {
                        <option value="@sort.Key" selected="@(sort.Key == _sort.Key)">@sort.Label</option>
                    }
                </select>
            </div>
        }

        <div class="bar-end">
            @if (_filter.Any)
            {
                <button type="button" class="clear-all" @onclick="ClearFilters">Clear filters</button>
            }
            <ViewToggle List="_asTable" ListChanged="ViewChanged" />
        </div>
    </div>

    <p class="tally">
        @Shown.Count of @_all.Count item@(_all.Count == 1 ? "" : "s")
    </p>

    @if (Shown.Count == 0)
    {
        <p class="nothing">
            @(_all.Count == 0 ? "Nothing here yet." : "Nothing matches those filters.")
        </p>
    }
    else if (_asTable)
    {
        <ItemTable Rows="Shown" Sorts="_sorts" Sort="_sort" SortChanged="SortPicked" OnInfo="Open" />
    }
    else
    {
        <div class="card-grid">
            @foreach (var row in Shown)
            {
                <ItemCard Row="row" OnInfo="Open" @key="row.Id" />
            }
        </div>
    }

    @if (_open is { } open)
    {
        <ItemModal Row="open" OnClose="CloseItem" @key="open.Id" />
    }
}

@code {
    /// <summary>Which page's rows to show.</summary>
    [Parameter, EditorRequired]
    public required string Page { get; set; }

    /// <summary>The heading over the list.</summary>
    [Parameter, EditorRequired]
    public required string Heading { get; set; }

    private IReadOnlyList<GalleryRow>? _all;
    private IReadOnlyList<Facet<GalleryRow>> _facets = [];
    private IReadOnlyList<SortOption> _sorts = [];
    private SortOption _sort;
    private Sifter<GalleryRow>? _sifter;
    private bool _asTable;

    // One modal for the page. A modal per card would be seventeen dialogs in the document,
    // sixteen of them holding a fetch nobody asked for.
    private GalleryRow? _open;

    // Memoised against the list it was built from, so narrowing and ordering happen once
    // per change rather than once per render.
    private IReadOnlyList<GalleryRow>? _shown;

    private Sifter<GalleryRow> _filter => _sifter!;

    private IReadOnlyList<GalleryRow> Shown =>
        _shown ??= GalleryFacets.Sort(
            _filter.Any ? _all!.Where(_filter.Matches) : _all!, _sort);

    protected override async Task OnParametersSetAsync()
    {
        // Loaded before the headings are built, so the technology heading can name what it
        // offers rather than listing raw ids.
        var tech = await Tech.IndexAsync().ConfigureAwait(true);

        _facets = GalleryFacets.For(Page, tech);
        _sorts = GalleryFacets.SortsFor(Page);
        _sort = _sorts[0];
        _sifter = new Sifter<GalleryRow>(_facets, r => r.SearchText);
        _shown = null;
        _all = null;

        _all = await Data.ForPageAsync(Page).ConfigureAwait(true);
    }

    private void FilterChanged()
    {
        _shown = null;
        StateHasChanged();
    }


    private void SortChanged(ChangeEventArgs e)
    {
        string key = e.Value?.ToString() ?? "";
        _sort = _sorts.FirstOrDefault(s => s.Key == key, _sorts[0]);
        _shown = null;
    }

    /// <summary>
    /// Takes the order a table heading asked for, direction and all - the table is what knows
    /// whether the press was a new column or the same one turned around.
    /// </summary>
    private void SortPicked(SortOption sort)
    {
        _sort = sort;
        _shown = null;
    }

    private void ClearFilters()
    {
        _filter.Clear();
        _shown = null;
    }

    private void ViewChanged(bool asTable) => _asTable = asTable;

    private void Open(GalleryRow row) => _open = row;

    private void CloseItem() => _open = null;
}
