@*
    One item as a card: the primary image, name, type, class, seed, tags and base stats.
*@

<article class="item-card">
    <div class="card-art">
        @*
            A carousel rather than the first picture and nothing else: a ship photographed
            from outside and again from its stats panel is two pictures worth seeing, and
            opening the item to find that out is a click to learn there was something to see.
        *@
        @if (Row.Images.Count > 0)
        {
            <ImageCarousel Images="Row.Images" Name="@Row.DisplayName" Compact="true"
                           OnPick="Enlarge" />
        }
        else
        {
            <span class="no-art" aria-hidden="true">@Initial</span>
        }
    </div>

    <div class="card-body">
        @*
            The two buttons live on the title row rather than in a bar of their own. A footer
            is a whole extra band of card for two icons, and it pushed everything below the
            picture down by its own height on every card on the page.
        *@
        <div class="card-head">
            <div class="titles">
                <h2 class="card-name">
                    <ClassBadge Class="@Row.Class" />
                    <span class="name-text">@Row.DisplayName</span>
                </h2>

                @*
                    What else the thing is called, tucked under the name rather than beside it:
                    an in-game name that differs from the one the gallery lists it under, or a
                    nickname people search for. Italic so it reads as a gloss on the name above
                    and not as a second name of equal standing.
                *@
                @if (Row.AlternativeNames.Count > 0)
                {
                    <p class="aka">@string.Join(", ", Row.AlternativeNames)</p>
                }
            </div>

            <div class="actions">
                <button type="button" class="info icon" title="@($"More about {Row.DisplayName}")"
                        aria-label="@($"More about {Row.DisplayName}")"
                        @onclick="() => OnInfo.InvokeAsync(Row)">
                    <Icon Name="info" Size="20" Class="tech" />
                </button>

                <DownloadMenu Row="Row" Compact="true" />
            </div>
        </div>

        <p class="card-type">
            <span>@Row.Type</span>
            @if (Row.IsModified)
            {
                <span class="badge warn" title="The model path did not match a known ship exactly">Modified</span>
            }
        </p>

        @if (Row.Summary is { Length: > 0 } summary)
        {
            @* One line by design - the full text is in the item's own view, not squeezed here. *@
            <p class="card-summary">@summary</p>
        }

        @foreach (var seed in Row.Seeds)
        {
            <p class="card-seed"><span class="dim">@seed.Key</span> <code>@seed.Value</code></p>
        }

        @if (Row.Stats.Count > 0)
        {
            <dl class="card-stats" data-count="@Row.Stats.Count">
                @foreach (var stat in Row.Stats)
                {
                    <div>
                        <dt>@stat.Key</dt>
                        @* Raw values: the game exposes no maxima to scale a bar against. *@
                        <dd>@stat.Value.ToString("0.#")</dd>
                    </div>
                }
            </dl>
        }

        @if (Row.Tags.Count > 0)
        {
            <p class="card-tags">
                @foreach (var tag in Row.Tags)
                {
                    <span class="chip">@tag</span>
                }
            </p>
        }
    </div>
</article>

@code {
    /// <summary>The item to draw.</summary>
    [Parameter, EditorRequired]
    public required GalleryRow Row { get; set; }

    /// <summary>Raised when the reader asks to see the whole item.</summary>
    [Parameter]
    public EventCallback<GalleryRow> OnInfo { get; set; }

    /// <summary>
    /// Raised with the item and the picture being shown when the reader asks to see it larger.
    /// </summary>
    [Parameter]
    public EventCallback<(GalleryRow Row, int At)> OnEnlarge { get; set; }

    private string Initial => Row.DisplayName.Length > 0 ? Row.DisplayName[..1].ToUpperInvariant() : "?";

    private Task Enlarge(int at) => OnEnlarge.InvokeAsync((Row, at));
}
