@inject ExportService Exports
@inject TechData TechSource
@inject PetData PetSource
@inject IJSRuntime Js
@implements IAsyncDisposable

@*
    One item, in full: its pictures, what it is, what it carries, and where to get it.

    The card is built from the manifest, which holds only what a card and a filter need. This
    is the first thing that wants the item document itself - the description, the grid, the
    slot-by-slot contents - so the document is fetched when the modal opens and never before.
    That is the whole reason the manifest stays small.
*@

<div class="vault-modal item-modal" @onclick="Close">
    <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="@_titleId"
         tabindex="-1" @ref="_sheet" @onkeydown="OnKey" @onclick:stopPropagation="true">

        <header class="head">
            <div class="titles">
                <h2 id="@_titleId">
                    <ClassBadge Class="@Row.Class" />
                    <AffinityBadge Affinity="@Row.Affinity" />
                    <span class="name-text">@Row.DisplayName</span>
                </h2>

                @if (Row.AlternativeNames.Count > 0)
                {
                    <p class="aka">@string.Join(", ", Row.AlternativeNames)</p>
                }
            </div>

            <button type="button" class="shut" title="Close" aria-label="Close" @onclick="Close">
                <Icon Name="close" Size="18" />
            </button>
        </header>

        <p class="kind">
            <span>@Row.Type</span>
            @if (Row.IsModified)
            {
                <span class="badge warn" title="The model path did not match a known ship exactly">Modified</span>
            }
            @* A creature has a block of its own for these, holding all five rather than the
               two that name it. *@
            @if (_creature is null)
            {
                @foreach (var seed in Row.Seeds)
                {
                    <span class="seed"><span class="dim">@seed.Key</span> <code>@seed.Value</code></span>
                }
            }
        </p>

        @if (_images.Count > 0)
        {
            <ImageCarousel Images="_images" Name="@Row.DisplayName" />
        }

        @if (_item is null && _failed is null)
        {
            <p class="dim loading">Reading the item&hellip;</p>
        }
        else if (_failed is { } failed)
        {
            <p class="failed">@failed</p>
        }

        @if (Description is { Length: > 0 } description)
        {
            <div class="prose">
                @foreach (string paragraph in description.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                {
                    <p>@paragraph.Trim()</p>
                }
            </div>
        }

        @if (Row.Stats.Count > 0)
        {
            <dl class="modal-stats">
                @foreach (var stat in Row.Stats)
                {
                    <div>
                        <dt>@stat.Key</dt>
                        <dd>@stat.Value.ToString("0.#")</dd>
                    </div>
                }
            </dl>
        }

        @if (_creature is { } creature)
        {
            <section class="creature">
                @*
                    Everything the payload says about the creature, and only about the creature.
                    Trust and the two moods are not here: they are how the last save left it
                    rather than anything about the animal, and across twelve real creatures they
                    were identical on every one.

                    The three traits are the interesting middle case. Comparing each creature
                    with the egg it hatched from shows them drifting - eight of twelve pairs
                    differ - so they are not fixed at hatching the way a seed is, but they are
                    close enough to a property of the creature to belong here.
                *@
                <div class="traits">
                    <h3>Nature</h3>

                    @*
                        Labelled rather than a row of chips. Each of these is a named field with
                        one value - a climate, a rarity, a yes or a no - and as chips they read
                        as an unordered bag where "Unfurred" and "Common" looked like the same
                        kind of thing. The species id went with them: it is the creature's type,
                        which the subtitle above already gives in the game's own words.

                        Resolved at ingest rather than here, because the table shows the same
                        fields as columns and two places working it out separately is two places
                        to disagree.

                        Egg-modified is not among them. It is false on all twenty-four files to
                        hand - every creature and every egg - so the row only ever said no.
                    *@
                    @if (Row.Nature is { } nature)
                    {
                        <dl class="pairs nature">
                            @foreach (var (label, value) in nature.Fields)
                            {
                                <div @key="label">
                                    <dt>@label</dt>
                                    <dd>@value</dd>
                                </div>
                            }
                        </dl>
                    }

                    @if (creature.CustomName is { Length: > 0 } given)
                    {
                        @* What its owner called it, which need not be what the gallery lists it under. *@
                        <p class="given">Named <em>@given</em> by its owner</p>
                    }
                </div>

                @if (Row.Traits.Count > 0)
                {
                    <div class="personality">
                        <h3>Personality</h3>

                        @*
                            Three numbers between -1 and 1, each an axis with a name at either
                            end: the sign picks the end and the magnitude says how far along it.
                            The words are the game's own.
                        *@
                        <dl class="pairs">
                            @foreach (var trait in Row.Traits)
                            {
                                <div>
                                    <dt>@trait.Name</dt>
                                    <dd>@trait.Rating</dd>
                                </div>
                            }
                        </dl>
                    </div>
                }

                @if (creature.Seeds.Count > 0)
                {
                    <div class="seeds">
                        <h3>Seeds</h3>

                        <dl class="pairs wide">
                            @foreach (var seed in creature.Seeds)
                            {
                                <div>
                                    <dt>@seed.Label</dt>
                                    <dd><code>@seed.Value</code></dd>
                                </div>
                            }
                        </dl>
                    </div>
                }

                @*
                    What the affinity is actually for. "Tropical" on its own says nothing; what
                    beats it and what it beats is the part worth knowing.

                    The three core stats used to sit above this and no longer do. The payload
                    holds a class letter for each, but only as an override the game ignores
                    unless a flag beside them is set - and it is not on anything hatched the
                    ordinary way, where the real classes are generated from the creature. Three
                    rows reading "Procedural" said nothing three times over. The feeding counters
                    went with them: zero on everything, and a gallery is not a save editor.
                *@
                @if (_matchup is { } matchup)
                {
                    <div class="arena">
                        <h3>Affinity</h3>

                        <dl class="pairs wide matchups">
                            <div>
                                <dt>Weak against</dt>
                                <dd>@AffinityList(matchup.Weak)</dd>
                            </div>
                            <div>
                                <dt>Strong against</dt>
                                <dd>@AffinityList(matchup.Strong)</dd>
                            </div>
                        </dl>
                    </div>
                }

                @if (creature.BattleMoves.Count > 0)
                {
                    <div class="moves">
                        <h3>Battle moves</h3>

                        @*
                            A move's name depends on the creature's affinity as much as on the
                            move: the same ATTACK is Lash on a tropical creature and Freeze on a
                            frost one. Unresolved ones fall back to the id, which is what every
                            move used to show.

                            Two glyphs each, as the game draws them: what the move is typed to,
                            and the stat it touches. They are often the same thing said twice
                            and sometimes not - a mechanical creature's plain attack shows cogs
                            and a starburst.
                        *@
                        <ul class="move-list">
                            @foreach (string id in creature.BattleMoves)
                            {
                                var move = _pets.Move(id, _affinity);

                                <li @key="id" title="@move.Description">
                                    <span class="glyphs">
                                        @if (move.Affinity?.Icon is { Length: > 0 } typed)
                                        {
                                            <img src="@($"gallery/img/affinity/{typed}")"
                                                 alt="@move.Affinity.Name" title="@move.Affinity.Name"
                                                 loading="lazy" onerror="this.remove()" />
                                        }
                                        @if (move.Icon is { Length: > 0 } glyph)
                                        {
                                            <img src="@($"gallery/img/move/{glyph}")" alt="" loading="lazy"
                                                 onerror="this.remove()" />
                                        }
                                    </span>
                                    <span class="name">@move.Name</span>

                                    @if (move.Target is { Length: > 0 } target)
                                    {
                                        <span class="dim">@target</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (creature.AccessorySlots > 0)
                {
                    <p class="dim accessories">
                        @creature.AccessoriesWorn of @creature.AccessorySlots accessory
                        slot@(creature.AccessorySlots == 1 ? "" : "s") in use
                    </p>
                }
            </section>
        }

        @if (_inventory is { } inventory)
        {
            <section class="inventories">
                <h3>@inventory.Label</h3>

                <TechGridView Grid="inventory.Grid" Label="@inventory.Label" Tech="_tech" />

                @* No key for a cell nobody owns: it is drawn as nothing, and nothing needs
                   no explaining. *@
                <p class="legend dim">
                    <span class="key filled"></span> installed
                    <span class="key empty"></span> empty
                    <span class="key super"></span> supercharged
                </p>
            </section>
        }

        @if (Row.Tags.Count > 0)
        {
            <p class="card-tags">
                @foreach (string tag in Row.Tags)
                {
                    <span class="chip">@tag</span>
                }
            </p>
        }

        <footer class="foot">
            <p class="credit dim">
                @if (Author is { Length: > 0 } author)
                {
                    <span>Contributed by @author</span>
                }
                @if (GameVersion is { Length: > 0 } version)
                {
                    <span>Captured in @version</span>
                }
            </p>

            <DownloadMenu Row="Row" />
        </footer>
    </div>
</div>

@*
    An affinity as the game shows one: its glyph and its name. The same eight circles the badge
    beside the creature's name uses, so a reader matching "weak against MECHANICAL" to a
    mechanical creature is matching a picture rather than a word.
*@
@{
    RenderFragment AffinityList(IReadOnlyList<PetAffinity> affinities) =>
        @<span class="affinities">
            @foreach (var affinity in affinities)
            {
                <span class="affinity" @key="affinity.Id">
                    @if (affinity.Icon is { Length: > 0 } glyph)
                    {
                        <img src="@($"gallery/img/affinity/{glyph}")" alt="" loading="lazy"
                             onerror="this.remove()" />
                    }
                    <span>@affinity.Name</span>
                </span>
            }
        </span>;
}

@code {
    /// <summary>The item to show, as the manifest has it.</summary>
    [Parameter, EditorRequired]
    public required GalleryRow Row { get; set; }

    /// <summary>Raised when the modal should go away.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private readonly string _titleId = $"item-{Guid.NewGuid():N}";
    private readonly CancellationTokenSource _leaving = new();

    private ElementReference _sheet;
    private IJSObjectReference? _module;
    private VaultItem? _item;
    private TechIndex _tech = TechIndex.Empty;
    private PetIndex _pets = PetIndex.Empty;
    private PetAffinity? _affinity;
    private PetMatchup? _matchup;
    private NamedInventory? _inventory;
    private CompanionFacts? _creature;
    private IReadOnlyList<string> _images = [];
    private string? _failed;
    private string? _loadedFor;

    /// <summary>
    /// The full text, which lives in the document rather than the manifest. Falls back to the
    /// card's one-liner while the document is on its way, so the space does not jump.
    /// </summary>
    private string? Description =>
        _item?.Meta.Description is { Length: > 0 } full ? full : Row.Summary;

    private string? Author => _item?.Meta.Author;

    private string? GameVersion => _item?.Meta.GameVersion;

    protected override async Task OnParametersSetAsync()
    {
        // Guarded because a parameter change that is not a change of item - a parent redraw -
        // must not refetch and blank the sheet.
        if (_loadedFor == Row.Id) { return; }

        _loadedFor = Row.Id;
        _item = null;
        _inventory = null;
        _creature = null;
        _failed = null;

        // The card's picture is shown at once so the sheet has something in it immediately;
        // the rest of the pictures are in the document.
        _images = Row.Image is { } image ? [image] : [];

        try
        {
            // Inside the try with the item fetch, not above it. Closing the sheet cancels the
            // token, and TechData only catches HttpRequestException and JsonException - so a
            // close during a cold tech.json load threw straight into Blazor's error bar.
            _tech = await TechSource.IndexAsync(_leaving.Token).ConfigureAwait(true);

            // Only for a creature. A page of ships has no use for it, and it is a separate
            // fetch.
            if (Row.Kind == EntityKind.Companion)
                _pets = await PetSource.IndexAsync(_leaving.Token).ConfigureAwait(true);
            _item = await Exports.ItemAsync(Row.Id, _leaving.Token).ConfigureAwait(true);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            // JsonException as well as the request failure: a document that is there but
            // unreadable is the same thing to a reader, and letting it escape a component
            // takes down the page rather than the sheet.
            // The guard is cleared as well as set, so reopening this item tries again. Without
            // it a single failure - a request landing while the gallery was being rewritten -
            // short-circuited every later attempt and redrew this message for the life of the
            // page, which made a momentary blip look like a broken item.
            _loadedFor = null;
            _failed = "That item could not be read. It may not have finished publishing.";
            return;
        }
        catch (OperationCanceledException)
        {
            // The sheet was closed while this was in flight. Nothing to report and nothing
            // left to draw into - but the guard is cleared for the same reason as above, so
            // that closing this item mid-fetch does not leave it permanently blank.
            _loadedFor = null;
            return;
        }

        if (_item.Meta.Images.Count > 0) { _images = _item.Meta.Images; }

        _inventory = ItemInventories.Shown(_item);
        _creature = _item.Kind == EntityKind.Companion
            ? CompanionFacts.For(_item.Payload, _item.AccessorySlots)
            : null;

        _affinity = _creature is null
            ? null
            : _pets.Affinity(_creature.SpeciesId, _creature.Biome);

        _matchup = _pets.Matchup(_affinity);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { return; }

        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./vault.js").ConfigureAwait(true);

        // Before the sheet takes focus, so the trap can remember what had it and give it back
        // on close. This is what makes aria-modal above true rather than a claim: inert takes
        // the rest of the page out of tab order and out of the accessibility tree.
        await _module.InvokeVoidAsync("trapFocus", _sheet).ConfigureAwait(true);

        await _sheet.FocusAsync().ConfigureAwait(true);
        await _module.InvokeVoidAsync("lockPageScroll", true).ConfigureAwait(true);
    }

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>Abandons a fetch still running, and gives the page back its scrollbar.</summary>
    /// <returns>A task that completes once both are done.</returns>
    public async ValueTask DisposeAsync()
    {
        _leaving.Cancel();
        _leaving.Dispose();

        if (_module is null) { return; }

        try
        {
            await _module.InvokeVoidAsync("lockPageScroll", false).ConfigureAwait(false);
            await _module.InvokeVoidAsync("releaseFocus").ConfigureAwait(false);
            await _module.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first, and took its scrollbar with it.
        }
    }
}
