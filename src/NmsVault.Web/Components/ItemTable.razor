@*
    The same items as a table: everything the card shows, with a smaller image, so a long
    list can be read down rather than scrolled through.

    The headings do the sorting here, which is why the bar above drops its dropdown in this
    view - a table with sortable columns and a sort control over it gives two ways to say the
    same thing and one place for them to disagree.

    Stat columns are taken from the first row rather than written out per page, so the table
    cannot offer a column the items do not carry. Which columns can be sorted is not decided
    here either: a heading is sortable exactly when the page offers a sort of the same name.
*@

@*
    A scrollable region, so it needs a name and a tab stop - otherwise the only way to reach the
    columns off the right edge is to Tab through the buttons in every row.
*@
<div class="table-wrap" tabindex="0" role="region" aria-label="Items, as a table">
    <table class="item-table">
        <thead>
            <tr>
                <th scope="col" class="col-art"><span class="visually-hidden">Image</span></th>

                @foreach (var column in Columns)
                {
                    var sort = SortFor(column.Label);
                    var active = sort is { } s && s.Key == Sort.Key;

                    <th scope="col" class="@column.Css" @key="column.Label"
                        aria-sort="@(active ? (Sort.Descending ? "descending" : "ascending") : null)">
                        @if (sort is { } option)
                        {
                            <button type="button" class="sorter @(active ? "active" : null)"
                                    title="@Hint(option, active)" @onclick="() => Pick(option)">
                                <span>@column.Label</span>
                                @* Marked only on the column in use; an arrow on every heading is
                                   four arrows saying nothing. *@
                                <span class="arrow" aria-hidden="true">
                                    @if (active)
                                    {
                                        <Icon Name="@(Sort.Descending ? "chevron-down" : "chevron-up")" Size="12" Weight="2.6" />
                                    }
                                </span>
                            </button>
                        }
                        else
                        {
                            @column.Label
                        }
                    </th>
                }

                <th scope="col" class="col-actions"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var row in Rows)
            {
                <tr @key="row.Id">
                    <td class="col-art">
                        @*
                            A thumbnail this size settles which row you are looking at and
                            nothing else, so it opens the pictures full size. No carousel in
                            the cell itself - arrows at 48 pixels across would be a target
                            nobody can hit, and the larger view pages through them anyway.

                            No count of the other pictures either. Down a column it read as a
                            number that meant something about the ship, and what it actually
                            said - that there are two photographs rather than one - is not
                            worth a badge on every row.
                        *@
                        @if (row.Image is { } image)
                        {
                            <button type="button" class="art" @onclick="() => Enlarge(row)"
                                    title="@($"See {row.DisplayName} larger")"
                                    aria-label="@($"See {row.DisplayName} larger")">
                                <img src="@($"gallery/{image}")" alt="" loading="lazy" />
                            </button>
                        }
                    </td>

                    <td class="col-name">
                        @row.DisplayName
                        @if (row.AlternativeNames.Count > 0)
                        {
                            <span class="aka">@string.Join(", ", row.AlternativeNames)</span>
                        }
                    </td>

                    <td>
                        @row.Type
                        @if (row.IsModified)
                        {
                            <span class="badge warn" title="The model path did not match a known ship exactly">M</span>
                        }
                    </td>

                    @if (HasClass)
                    {
                        <td class="col-class"><ClassBadge Class="@row.Class" /></td>
                    }

                    @if (HasAffinity)
                    {
                        <td class="col-affinity"><AffinityBadge Affinity="@row.Affinity" /></td>
                        <td class="col-traits">
                            @foreach (var trait in row.Traits)
                            {
                                <span class="chip" title="@($"{trait.Name} {trait.Rating}")">@(trait.Word ?? trait.Name)</span>
                            }
                        </td>

                        @* The same fields the item's own view lists, one per column. *@
                        @foreach (string label in NatureColumns)
                        {
                            <td class="col-nature">@Nature(row, label)</td>
                        }
                    }

                    @* One column per seed rather than all of them stacked in one cell. A ship
                       has a single seed and reads the same as before; a creature has two, and
                       had them jammed together in a column headed "Seed". *@
                    @foreach (string label in SeedColumns)
                    {
                        <td class="col-seed">
                            @if (row.Seeds.TryGetValue(label, out string? seed))
                            {
                                <code>@seed</code>
                            }
                        </td>
                    }

                    @foreach (var stat in StatColumns)
                    {
                        <td class="col-stat">@Value(row, stat)</td>
                    }

                    <td>
                        @foreach (var tag in row.Tags)
                        {
                            <span class="chip">@tag</span>
                        }
                    </td>

                    @* The buttons sit in their own row inside the cell rather than the cell
                       being that row: a table cell told to be a flex container stops sizing
                       itself the way the column needs. *@
                    <td class="col-actions">
                        <div class="actions">
                            <button type="button" class="info icon" title="@($"More about {row.DisplayName}")"
                                    aria-label="@($"More about {row.DisplayName}")"
                                    @onclick="() => OnInfo.InvokeAsync(row)">
                                <Icon Name="info" Size="20" Class="tech" />
                            </button>

                            <DownloadMenu Row="row" Compact="true" />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    /// <summary>One column between the image and the buttons.</summary>
    /// <param name="Label">Its heading, which also names the sort it offers.</param>
    /// <param name="Css">Its class, where it needs one.</param>
    private sealed record Column(string Label, string? Css = null);

    /// <summary>The items to draw.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<GalleryRow> Rows { get; set; }

    /// <summary>Every order the page offers, which decides which headings are pressable.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<SortOption> Sorts { get; set; }

    /// <summary>The order the rows are in.</summary>
    [Parameter, EditorRequired]
    public required SortOption Sort { get; set; }

    /// <summary>Raised when a heading is pressed.</summary>
    [Parameter]
    public EventCallback<SortOption> SortChanged { get; set; }

    /// <summary>Raised when the reader asks to see a whole item.</summary>
    [Parameter]
    public EventCallback<GalleryRow> OnInfo { get; set; }

    /// <summary>
    /// Raised with the item when the reader asks to see its pictures larger. Always from the
    /// first, because the cell shows only the first.
    /// </summary>
    [Parameter]
    public EventCallback<(GalleryRow Row, int At)> OnEnlarge { get; set; }

    private Task Enlarge(GalleryRow row) => OnEnlarge.InvokeAsync((row, 0));

    private IReadOnlyList<string> StatColumns =>
        Rows.Count == 0 ? [] : [.. Rows[0].Stats.Select(s => s.Key)];

    /// <summary>
    /// Whether these rows have a class at all. Only ships and multitools do, so on the
    /// companions page the column was there and empty in every row.
    /// </summary>
    private bool HasClass => Rows.Any(r => r.Class is { Length: > 0 });

    /// <summary>The other way round: only creatures carry an affinity.</summary>
    private bool HasAffinity => Rows.Any(r => r.Affinity is not null);

    /// <summary>
    /// The nature fields any of these rows carries, in the order they read.
    /// </summary>
    /// <remarks>
    /// Taken from the rows rather than written out here, so a column cannot appear for a field
    /// nothing has - the arena column shows up only on a page holding a species that cannot
    /// fight, which is how it stays out of the way the rest of the time.
    /// </remarks>
    private IReadOnlyList<string> NatureColumns =>
        [.. Rows.SelectMany(r => r.Nature?.Fields ?? []).Select(f => f.Key).Distinct()];

    /// <summary>
    /// The seeds any of these rows carries, in the order they first appear.
    /// </summary>
    /// <remarks>
    /// Taken from the rows for the same reason the nature columns are: a page shows a column
    /// only for a seed something on it actually has. Ships and multi-tools carry one, labelled
    /// Seed, so their table is unchanged; creatures carry a species and a genus.
    /// </remarks>
    private IReadOnlyList<string> SeedColumns =>
        [.. Rows.SelectMany(r => r.Seeds.Keys).Distinct()];

    /// <summary>One row's value for a nature column, or empty where it has none.</summary>
    private static string Nature(GalleryRow row, string label)
    {
        foreach (var (key, value) in row.Nature?.Fields ?? [])
            if (string.Equals(key, label, StringComparison.Ordinal)) return value;

        return "";
    }

    private IReadOnlyList<Column> Columns =>
    [
        new("Name", "col-name"),
        new("Type"),
        .. HasClass ? (Column[])[new("Class", "col-class")] : [],
        .. HasAffinity
            ? (Column[])[new("Affinity", "col-affinity"), new("Personality", "col-traits"),
                         .. NatureColumns.Select(label => new Column(label, "col-nature"))]
            : [],
        .. SeedColumns.Select(label => new Column(label, "col-seed")),
        .. StatColumns.Select(stat => new Column(stat, "col-stat")),
        new("Tags"),
    ];

    /// <summary>
    /// The sort a heading offers, or null where the page offers none of that name. Seed and
    /// Tags fall through here, which is the intended answer rather than an oversight: neither
    /// has an order a reader would be looking for.
    /// </summary>
    private SortOption? SortFor(string label)
    {
        foreach (var sort in Sorts)
            if (string.Equals(sort.Label, label, StringComparison.Ordinal)) return sort;
        return null;
    }

    private static string Hint(SortOption sort, bool active) =>
        active ? $"Sort by {sort.Label} the other way round" : $"Sort by {sort.Label}";

    /// <summary>
    /// Pressing the column already in use turns it around; pressing another starts it in the
    /// direction that column is usually wanted in - names from A, stats from the best down.
    /// </summary>
    private Task Pick(SortOption sort)
        => SortChanged.InvokeAsync(sort.Key == Sort.Key
            ? Sort with { Descending = !Sort.Descending }
            : sort);

    private static string Value(GalleryRow row, string label)
    {
        foreach (var stat in row.Stats)
            if (string.Equals(stat.Key, label, StringComparison.Ordinal))
                return stat.Value.ToString("0.#");
        return "";
    }
}
