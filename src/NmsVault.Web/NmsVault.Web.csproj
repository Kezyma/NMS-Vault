<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      index.html names the Blazor script through a fingerprint placeholder; this substitutes
      the real name rather than shipping the placeholder text.
    -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!--
      The runtime files keep their plain names.

      Publish would otherwise rename dotnet.js to dotnet.<hash>.js, and the loader asks for
      "dotnet.js" flatly - no boot manifest is published and index.html carries no import map,
      so the only thing that can reconcile the two is a server that reads the static web assets
      manifest and serves the hashed file under the plain route. The dev server does. GitHub
      Pages serves files off a disk and cannot, so the app loaded its shell, failed to start
      the platform, and showed its loading message forever.

      Only these are affected. The assemblies stay fingerprinted, because the loader reads
      their real names from the boot configuration inside dotnet.js rather than guessing.
    -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NmsVault.Core\NmsVault.Core.csproj" />

    <!--
      Referenced so that restoring and building this project restores and builds the tool too.
      Nothing is linked and nothing is copied - the target below runs it as a program. Doing it
      with an <MSBuild> task instead looked tidier and was wrong: a task builds what it is
      pointed at but nothing restores it, so a clean checkout failed with NETSDK1004 on a
      project the developer never asked for.
    -->
    <ProjectReference Include="..\..\tools\NmsVault.Ingest\NmsVault.Ingest.csproj"
                      ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      A Blazor app counts as self-contained, and the SDK refuses to let one reference a
      framework-dependent executable in case it ends up shipped inside it. Nothing is shipped
      here: ReferenceOutputAssembly and ExcludeAssets above mean the reference carries no
      assets at all and exists only to order the build.
    -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The exports, pictures and metadata files the gallery is built from. -->
    <VaultData>$(MSBuildThisFileDirectory)..\..\data</VaultData>

    <VaultGallery>$(MSBuildThisFileDirectory)wwwroot\gallery</VaultGallery>

    <!--
      The tool that was just built, run directly. "dotnet run" would start a second build of a
      project this build is already building, and the two would race for the same files.
    -->
    <IngestTool>$(MSBuildThisFileDirectory)..\..\Build\bin\NmsVault.Ingest\$(Configuration)\net10.0\nmsvault-ingest.dll</IngestTool>

    <!-- Set false to build against whatever is already in the gallery folder. -->
    <BuildGallery Condition="'$(BuildGallery)' == ''">true</BuildGallery>
  </PropertyGroup>

  <!--
    The gallery is generated rather than committed, so it has to be built before the site is.
    Doing it here rather than only in the workflow means the site somebody builds is the site the
    workflow publishes, and that editing anything under data/ is enough to see it.

    After the project references are built, because the tool is one of them and has to exist
    before it can be run - and before the static web assets are gathered, because what it writes
    are static web assets and the build has to find them already on disk.

    What it writes is gitignored. What it does not write - img/tech, img/class and the favicon -
    is committed, because producing those needs an NMSE checkout that no runner has.
  -->
  <Target Name="BuildGallery"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="ResolveStaticWebAssetsInputs;GetCopyToOutputDirectoryItems"
          Condition="'$(BuildGallery)' == 'true' And Exists('$(VaultData)')">

    <Error Condition="!Exists('$(IngestTool)')"
           Text="The ingest tool is not at $(IngestTool), so the gallery cannot be built. Pass -p:BuildGallery=false to build the site against the gallery as it stands." />

    <Message Importance="high" Text="Building the gallery from $(VaultData)" />

    <Exec Command="dotnet &quot;$(IngestTool)&quot; build --from &quot;$(VaultData)&quot; --gallery &quot;$(VaultGallery)&quot;"
          StandardOutputImportance="low" />
  </Target>

  <!--
    Where the site is served from. GitHub Pages serves a project page under the repository
    name, so every asset would otherwise resolve against the domain root and the page would
    come up blank. A custom domain would pass "/" here instead.
  -->
  <PropertyGroup>
    <PagesBase Condition="'$(PagesBase)' == ''">/NMS-Vault/</PagesBase>
  </PropertyGroup>

  <Target Name="PrepareForPages" AfterTargets="Publish" Condition="'$(PreparePages)' != 'false'">
    <PropertyGroup>
      <PagesRoot>$(PublishDir)wwwroot\</PagesRoot>
      <PagesIndex>$([System.IO.File]::ReadAllText('$(PagesRoot)index.html'))</PagesIndex>
    </PropertyGroup>

    <!--
      Checked rather than hoped for. A string replace that silently matches nothing publishes
      a blank site with nothing in the build log to say why.
    -->
    <Error Condition="!$(PagesIndex.Contains('&lt;base href=&quot;/&quot; /&gt;'))"
           Text="index.html has no &lt;base href=&quot;/&quot; /&gt; to rewrite, so the site would publish with the wrong base and come up blank." />

    <!-- Escaped because Lines is an item list and MSBuild splits it on semicolons. -->
    <WriteLinesToFile File="$(PagesRoot)index.html"
                      Lines="$([MSBuild]::Escape($(PagesIndex.Replace('&lt;base href=&quot;/&quot; /&gt;', '&lt;base href=&quot;$(PagesBase)&quot; /&gt;'))))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />

    <!-- A copy made at publish time, so it cannot drift from index.html. -->
    <Copy SourceFiles="$(PagesRoot)index.html" DestinationFiles="$(PagesRoot)404.html" />

    <Message Importance="high" Text="Prepared for GitHub Pages at $(PagesBase)" />
  </Target>

</Project>
