<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NmsVault.Core\NmsVault.Core.csproj" />
  </ItemGroup>

  <!-- Real editor exports, copied next to the test assembly so tests can read them. -->
  <ItemGroup>
    <Content Include="..\fixtures\**\*" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />

    <!-- The companion lookup is extraction output, committed beside the gallery rather than in
         the fixtures. The affinity tests read the real file so they cannot drift from it. -->
    <Content Include="..\..\src\NmsVault.Web\wwwroot\gallery\pets.json"
             LinkBase="gallery" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
