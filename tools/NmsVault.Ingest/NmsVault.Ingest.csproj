<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NmsVault.Ingest</RootNamespace>
    <AssemblyName>nmsvault-ingest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- Image work uses SkiaSharp, not System.Drawing: same reason the shared projects avoid
         it, and the extractor should not need a different answer from the browser. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NmsVault.Core\NmsVault.Core.csproj" />
  </ItemGroup>

</Project>
